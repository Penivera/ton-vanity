{
  "name": "ton-vanity-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "dev:express": "npm run build && npm run start:express",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main",
    "start:express": "node dist/index.js",
    "lint": "eslint .",
    "db:migrate": "typeorm migration:run -d src/database/data-source.ts",
    "db:generate": "typeorm migration:generate -d src/database/data-source.ts",
    "db:revert": "typeorm migration:revert -d src/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.3",
    "@nestjs/core": "^10.3.3",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.3",
    "@nestjs/platform-socket.io": "^10.3.3",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.3.3",
    "@ton-community/func-js": "^0.11.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/passport-jwt": "^4.0.1",
    "bull": "^4.11.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.0",
    "node-telegram-bot-api": "^0.63.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.6",
    "typescript": "^5.4.5",
    "typeorm": "^0.3.19",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.0.3",
    "@types/bull": "^4.10.0",
    "@types/uuid": "^10.0.0"
  }
}