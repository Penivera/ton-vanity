;; Simple Proxy Contract (Forwarder)
;; Relays any incoming internal messages to the target address stored in data.

#include "imports/stdlib.fc";

;; Data structure
;; target_address: MsgAddressInt
;; salt: uint64 (for vanity address generation)

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (msg_value < 10000000) { ;; ignore messages with too little value (under 0.01 TON) to avoid fee drain
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        ;; ignore all bounced messages
        return ();
    }
    
    slice sender_address = cs~load_msg_addr();
    
    ;; Load data
    slice ds = get_data().begin_parse();
    slice target_address = ds~load_msg_addr();
    int salt = ds~load_uint(64);

    ;; We forward the remaining value to target_address
    var msg = begin_cell()
        .store_uint(0x10, 6) ;; nobounce
        .store_slice(target_address)
        .store_coins(0)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_slice(in_msg_body);
        
    ;; Send message with mode 64 (carry all remaining value)
    send_raw_message(msg.end_cell(), 64);
}
