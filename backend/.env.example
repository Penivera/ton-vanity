PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production
TELEGRAM_BOT_TOKEN=
ADMIN_API_KEY=change-this-admin-key
ADMIN_DELETE_ALLOWLIST=vanity_generations

# Development DB (SQLite)
SQLITE_DB_PATH=vanity.dev.db

# Production DB (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=vanity

# Queue / Worker
REDIS_URL=redis://127.0.0.1:6379
# Alternative discrete Redis config (used when REDIS_URL is not set)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker runtime flags
ENABLE_BULLMQ_WORKER=false
WORKER_CONCURRENCY=1
WORKER_JOB_ATTEMPTS=3
WORKER_JOB_BACKOFF_MS=5000